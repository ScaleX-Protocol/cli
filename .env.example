# ScaleX CLI — Environment Variables

# ============================================================================
# API (read commands)
# ============================================================================
API_URL=https://base-sepolia-api.scalex.money
# API_URL=http://localhost:3000

# ============================================================================
# Chain (write commands)
# ============================================================================
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0x...

# ============================================================================
# Contract Addresses
# Base Sepolia (84532) defaults are built-in.
# Override here if needed or for other chains.
# ============================================================================
# SCALEX_ROUTER=0xc02dCE91749Db64f349ef3029E6d9b565454688B
# SCALEX_BALANCE_MANAGER=0xfE938b282ac5914A9e6F6AD39bAb73379D4Ad46D
# SCALEX_POOL_MANAGER=0x5F1E83f33fD58ab4c142b35BeBEC8cA941912b59
# SCALEX_AGENT_ROUTER=0x489981A135bD968df5A00FDE514298F9a87f5772
# SCALEX_PREDICTION=0x5f3735f44AC391467110010BBdB0B8928f0D8f1c
# SCALEX_TOKEN_REGISTRY=0x74C8ECB25EE920986142EB2BC7a01812C1CE1d03

# ============================================================================
# Agent Identity (for AgentRouter write commands)
# ============================================================================
SCALEX_AGENT_TOKEN_ID=
SCALEX_CHAIN_NAME=base-sepolia
