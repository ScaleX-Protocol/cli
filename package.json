{
  "name": "scalex-cli",
  "version": "1.0.0",
  "description": "ScaleX CLI — agent interface for the GTX CLOB DEX",
  "type": "module",
  "bin": {
    "scalex": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --minify",
    "dev": "bun run src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "incur": "^0.2.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
